---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { widthsFor } from '../lib/img';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  widths?: number[];
}
const { src, alt, sizes = '100vw', eager = false, class: cls, widths } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  widths={widths ?? widthsFor(src.width)}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  quality={70}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={cls}
/>
