---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getDict, abs, type Lang } from '../i18n';
import { breadcrumb, webPage } from '../lib/schema';
import { site, waLink } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
const p = d.contactPage;
const f = p.form;
---
<Base
  lang={lang}
  path="/contact/"
  title={p.seo.title}
  description={p.seo.description}
  current="contact"
  schema={[
    webPage('ContactPage', lang, '/contact/', p.seo.title, p.seo.description),
    breadcrumb([
      { name: d.ui.home, url: abs(lang, '/') },
      { name: p.eyebrow, url: abs(lang, '/contact/') },
    ]),
  ]}
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow">{p.eyebrow}</span>
      <h1>{p.title}</h1>
      <p class="lede">{p.sub}</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:clamp(72px,10vw,140px)">
    <div class="contact-grid">
      <form class="form rv" data-form novalidate data-key={site.web3formsKey || undefined} data-to={site.email} data-ok={f.ok} data-fail={f.fail} data-mail={f.mailFallback} data-required={f.required} data-sending={f.sending} aria-describedby="privacy">
        <div class="two-f">
          <div class="field"><label for="name">{f.name}</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
          <div class="field"><label for="email">{f.email}</label><input id="email" name="email" type="email" autocomplete="email" required dir="ltr" /></div>
        </div>
        <div class="two-f">
          <div class="field"><label for="phone">{f.phone}</label><input id="phone" name="phone" type="tel" autocomplete="tel" dir="ltr" /></div>
          <div class="field">
            <label for="type">{f.type}</label>
            <select id="type" name="type">{f.types.map((x) => <option value={x}>{x}</option>)}</select>
          </div>
        </div>
        <div class="field">
          <label for="budget">{f.budget}</label>
          <select id="budget" name="budget"><option value="">—</option>{f.budgets.map((x) => <option value={x}>{x}</option>)}</select>
        </div>
        <div class="field"><label for="message">{f.message}</label><textarea id="message" name="message" placeholder={f.messagePh} required></textarea></div>
        <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div><button class="btn btn-primary btn-lg" type="submit">{f.send} <Icon name="arrow" class="go flip" /></button></div>
        <p class="form-msg" role="status" aria-live="polite"></p>
        <p class="small" id="privacy">{f.privacy}</p>
      </form>

      <aside class="rv" style="--d:1">
        <div class="direct">
          <a class="dcard wa" href={waLink(d.ui.waHello)} target="_blank" rel="noopener">
            <span class="ic"><Icon name="chat" /></span>
            <span><small>WhatsApp</small><b dir="ltr">{site.phone}</b></span>
            <span class="tag">{p.fastest}</span>
          </a>
          <a class="dcard" href={`mailto:${site.email}`}>
            <span class="ic"><Icon name="mail" /></span>
            <span><small>Email</small><b>{site.email}</b></span>
          </a>
          <a class="dcard" href={`tel:${site.phone.replace(/\s/g, '')}`}>
            <span class="ic"><Icon name="phone" /></span>
            <span><small>{d.ui.call}</small><b dir="ltr">{site.phone}</b></span>
          </a>
        </div>
        <h2 style="font-size:1.7rem;margin-top:2.6rem">{p.nextTitle}</h2>
        <ol class="next-list">{p.next.map((x) => <li>{x}</li>)}</ol>
        <p class="status" style="margin-top:2rem"><span><i class="dot"></i>{d.ui.open}</span><span>{d.ui.beirutTime} <b class="clock" data-clock dir="ltr">--:--</b></span></p>
      </aside>
    </div>
  </section>
</Base>
